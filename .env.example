BRW_ENV=development
BRW_DATABASE_URL=sqlite:///./brw.db
BRW_DATA_ROOT=./data
BRW_ARTIFACT_ROOT=./artifacts

# ---- P9 Agent 模型接入（LLM 只做意图理解；缺 key 时确定性回退，功能不中断）----
# 用法：cp .env.example .env，然后一次只启用下面一组（其余保持注释）。
# 注意：.env 含密钥，已被 .gitignore 忽略，切勿提交。
#
# A. DeepSeek（推荐，OpenAI 兼容接口）：
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
BRW_LLM_MODEL=deepseek-chat
#
# B. OpenAI 官方（二选一：注释掉 A 组，取消下面注释）：
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# BRW_LLM_MODEL=gpt-4o-mini
#
# C. 通义千问 OpenAI 兼容模式（二选一：注释掉 A 组，取消下面注释）：
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# BRW_LLM_MODEL=qwen-plus
#
# D. 自建网关（二选一：注释掉 A 组，取消下面注释）：
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:8080/v1
# BRW_LLM_MODEL=my-model

# Production example:
# BRW_DATABASE_URL=postgresql+psycopg://brw:brw@localhost:5432/brw
